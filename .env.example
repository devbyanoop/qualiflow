# Copy this file to .env and fill in real values. .env is gitignored —
# .env.example is the only one that's committed, and it must never hold
# a real secret, only placeholders.

# --- Postgres (apps + knowledge base) ---
QUALIFLOW_PG_HOST=localhost
QUALIFLOW_PG_PORT=5433
QUALIFLOW_PG_USER=qualiflow
QUALIFLOW_PG_PASSWORD=changeme
QUALIFLOW_PG_DB=qualiflow
# Non-superuser role the APP connects as (never the POSTGRES_USER
# superuser above) -- see M0.3's roadmap note for why this matters.
QUALIFLOW_PG_APP_PASSWORD=changeme

# --- Redis (background jobs) ---
QUALIFLOW_REDIS_PORT=6379

# --- MinIO (S3-compatible object storage: evidence, fixtures) ---
QUALIFLOW_MINIO_API_PORT=9000
QUALIFLOW_MINIO_CONSOLE_PORT=9001
QUALIFLOW_MINIO_ROOT_USER=qualiflow
QUALIFLOW_MINIO_ROOT_PASSWORD=changeme-min-8-chars

# --- Keycloak (auth) ---
QUALIFLOW_KEYCLOAK_PORT=8080
QUALIFLOW_KEYCLOAK_ADMIN_USER=admin
QUALIFLOW_KEYCLOAK_ADMIN_PASSWORD=changeme
# Issuer must exactly match Keycloak's `iss` claim — same host/port the
# browser or API client reaches Keycloak on, not an internal Docker name.
QUALIFLOW_KEYCLOAK_ISSUER=http://localhost:8080/realms/qualiflow
QUALIFLOW_API_CLIENT_ID=qualiflow-api
QUALIFLOW_API_CLIENT_SECRET=changeme

# --- Observability: OTel Collector + Prometheus + Grafana ---
# (Langfuse deliberately not here — see Plan/qualiflow-build-plan.md §0)
QUALIFLOW_OTEL_GRPC_PORT=4317
QUALIFLOW_OTEL_HTTP_PORT=4318
QUALIFLOW_PROMETHEUS_PORT=9090
QUALIFLOW_GRAFANA_PORT=3000
QUALIFLOW_GRAFANA_ADMIN_USER=admin
QUALIFLOW_GRAFANA_ADMIN_PASSWORD=changeme
